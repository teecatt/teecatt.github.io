/build-info.js
  Cache-Control: public, max-age=31536000, immutable

/shared/*
  Cache-Control: public, max-age=31536000, immutable

# 音频转 MIDI：ONNX 多线程 wasm 需要 SharedArrayBuffer，必须跨域隔离。
# 只圈本目录（全站加会打断 midi_player 等页面的跨域 CDN）。credentialless 保证
# 对 jsdelivr / R2 的 CORS 拉取不断；popup 用 allow-popups 不影响外链新窗口。
/audio_to_midi/*
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Embedder-Policy: credentialless
# HTML 文档本身不缓存（每次重验证，304 开销可忽略）：杜绝“部署了用户还跑旧页面”
# 导致的一整类缓存背锅（旧 worker/旧 header 表现）。
/audio_to_midi/
  Cache-Control: public, max-age=0, must-revalidate
/midi_player_v2/
  Cache-Control: public, max-age=0, must-revalidate
